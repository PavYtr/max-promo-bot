# Copy to .env; Compose reads it automatically. For local go run, export these variables.
MAX_TOKEN=
BOT_MODE=webhook
HTTP_ADDR=:8080
WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-chars
WEBHOOK_URL=
MAX_API_URL=https://platform-api2.max.ru
MAX_CA_FILE=certs/russian_trusted_root_ca.crt
DATABASE_URL=postgres://festival:festival@localhost:15432/festival?sslmode=disable
REDIS_URL=redis://localhost:16379/0
FESTIVAL_TIMEZONE=Europe/Moscow
# Set the agreed number of grand-draw reserves (0..10000); empty disables creation.
GRAND_RESERVE_COUNT=
# Agreed grand winner response period, counted after successful delivery; empty blocks approval.
GRAND_RESPONSE_SECONDS=
# Name of the ticket operator receiving winner data; required to claim a grand prize.
GRAND_DATA_RECIPIENT=
ADMIN_IDS=
ADMIN_CHAT_ID=
BANNER_URL=
BANNER_TOKEN=
HOW_TO_TEXT=
RULES_TEXT=
